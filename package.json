{
  "name": "@canteen/offline-verifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n SERVER,WEB -c yellow,magenta \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node --watch server.js",
    "dev:web": "vite --host 0.0.0.0 --port 4001",
    "build": "vite build",
    "start": "node server.js",
    "start:server": "node server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@zxing/browser": "^0.1.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.1",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
